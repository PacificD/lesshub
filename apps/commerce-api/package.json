{
  "name": "@lesshub/commerce-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "vite build --config vite.config.ts",
    "runtime:check": "node ../../scripts/check-node22.cjs",
    "start": "corepack pnpm run runtime:check && node dist/server/server.js",
    "lint": "eslint src tests --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "corepack pnpm run runtime:check && vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@hono/node-server": "1.19.5",
    "@lesshub/commerce-contracts": "workspace:*",
    "hono": "4.10.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "@vitest/coverage-v8": "3.2.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.1.0",
    "vitest": "3.2.4"
  }
}
