{
  "name": "lesshub",
  "description": "PNPM + Turborepo",
  "version": "0.1.0",
  "author": "PacificD",
  "private": true,
  "keywords": [
    "Monorepo",
    "Turborepo",
    "PNPM",
    "Next.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PacificD/lesshub.git"
  },
  "license": "ISC",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@7.29.1",
  "scripts": {
    "preinstall": "node scripts/check-toolchain.cjs",
    "toolchain:check": "node scripts/check-toolchain.cjs",
    "runtime:check": "node scripts/check-node22.cjs",
    "dev": "node scripts/run-turbo.cjs run dev --parallel",
    "clean": "node scripts/run-turbo.cjs run clean",
    "clean:workspaces": "node scripts/run-turbo.cjs run clean",
    "lint": "node scripts/run-turbo.cjs run lint",
    "test": "node scripts/run-tests-with-report.mjs",
    "test:turbo": "node scripts/run-turbo.cjs run test --force",
    "test:e2e": "node scripts/check-node22.cjs && node scripts/run-turbo.cjs run test:e2e --filter=@lesshub/hono-react",
    "benchmark:quick": "node scripts/check-node22.cjs && corepack pnpm --filter @lesshub/hono-react benchmark:quick",
    "benchmark:full": "node scripts/check-node22.cjs && corepack pnpm --filter @lesshub/hono-react benchmark:full",
    "report:dashboard": "node scripts/generate-benchmark-dashboard.mjs",
    "db:generate": "node scripts/run-turbo.cjs run db:generate",
    "db:push": "node scripts/run-turbo.cjs run db:push db:generate",
    "studio": "node scripts/run-turbo.cjs run studio",
    "format": "prettier --write \"**/*.{js,cjs,mjs,ts,tsx,md,json}\" --ignore-path .gitignore",
    "type-check": "node scripts/run-turbo.cjs run type-check",
    "build": "node scripts/run-turbo.cjs run build",
    "build:verify": "corepack pnpm --filter @lesshub/hono-react build:verify",
    "ui:add": "pnpm --filter ui ui:add",
    "publish": "changeset publish --registry=https://registry.npmjs.org",
    "changeset": "changeset",
    "packages-version": "changeset version",
    "wasm-build": "wasm-pack build ./packages/wasm --target web"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "18.19.130",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@typescript-eslint/eslint-plugin": "^5.59.7",
    "@typescript-eslint/parser": "^5.59.7",
    "autoprefixer": "10.4.15",
    "eslint": "^8.41.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "postcss": "8.4.29",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.5.4",
    "tailwindcss": "3.3.3",
    "turbo": "^1.11.2",
    "typescript": "^5.0.4"
  }
}
